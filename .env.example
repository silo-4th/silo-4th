# Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# 기본 모델. 2026-11-04에 claude-sonnet-5-5로 정했다. 근거는 _docs/raw/2026-11-04-ai-model-selection-research.md다.
ANTHROPIC_MODEL=claude-sonnet-5-5
# 질문 개념 분류와 요약에 쓰는 모델. 2026-11-04에 claude-haiku-5-5로 정했다. 근거는 _docs/wiki/adr/0008-question-concept-summary.md다.
ANTHROPIC_UTILITY_MODEL=claude-haiku-5-5
# Sentry 소스맵 업로드용 토큰 (빌드할 때만 쓴다). 비어 있으면 업로드만 건너뛴다.
# 발급: Sentry > Settings > Developer Settings > Organization Tokens (https://eb5a968646b3.sentry.io/settings/auth-tokens/)
# DSN은 비밀값이 아니라 lib/sentry.ts에 들어 있으므로 여기에 두지 않는다.
SENTRY_AUTH_TOKEN=
# Neon 데이터베이스 주소. Neon 콘솔 > Connect에서 pooled 연결 문자열을 복사한다.
DATABASE_URL=
# 로그인 쿠키 서명용 비밀값. `openssl rand -base64 32`로 만든다.
AUTH_SECRET=
# 앱 주소. 로컬은 http://localhost:3000, 배포는 실제 도메인을 넣는다.
AUTH_URL=
# Google 로그인 OAuth 클라이언트. Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든다.
# 승인된 리디렉션 URI는 {AUTH_URL}/api/auth/callback/google 이다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
