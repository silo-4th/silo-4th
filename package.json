{
  "name": "recall-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "quiz:defaults:generate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/default-quiz-problems.mts generate",
    "quiz:defaults:migration": "node --conditions=react-server --import tsx scripts/default-quiz-problems.mts migration"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.49.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.10.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.70.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.3",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
